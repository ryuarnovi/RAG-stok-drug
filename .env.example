# PharmaStock Configuration

# Database
DB_URL=jdbc:mysql://localhost:3306/pharmastock?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
DB_POOL_SIZE=10

# AI Provider: LOCAL, OPENAI, GEMINI (LOCAL recommended, works offline)
AI_PROVIDER=LOCAL

# OpenAI (optional)
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-3.5-turbo

# Gemini (optional)
AI_GEMINI_API_KEY=
# Gemini model options: gemini-2.0-flash (recommended), gemini-2.5-flash, gemini-2.5-pro
AI_GEMINI_MODEL=gemini-2.0-flash

# Application
APP_NAME=PharmaStock
APP_VERSION=1.0.0
APP_NEAR_EXPIRY_DAYS=30

# Reports output directory
REPORTS_OUTPUT_DIR=reports
