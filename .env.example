# KEPO Configuration

# Database (PostgreSQL)
POSTGRES_DB=kepo
POSTGRES_USER=kepo
POSTGRES_PASSWORD=kepo123
DB_URL=jdbc:postgresql://db:5432/kepo
DB_USER=kepo
DB_PASSWORD=kepo123
DB_POOL_SIZE=10

# AI Provider: LOCAL, OPENAI, GEMINI
AI_PROVIDER=GEMINI

# OpenAI (optional)
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-3.5-turbo

# Gemini (optional)
AI_GEMINI_API_KEY=your-gemini-api-key
AI_GEMINI_MODEL=gemini-2.5-flash-lite

# Application
APP_NAME=KEPO
APP_VERSION=2.0.0
APP_NEAR_EXPIRY_DAYS=30

# Reports output directory
REPORTS_OUTPUT_DIR=/reports

# Server
SERVER_PORT=8080
